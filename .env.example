# Copy to .env and fill values locally. Never commit real credentials.
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=asia-northeast3
# Also export this path in the shell for Google Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Required by Settings; current database client uses the REST API below.
SUPABASE_DB_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Backend only. Never place a privileged key in static/ or browser JavaScript.
SUPABASE_KEY=your-backend-supabase-key

VOICE_EMOTION_CACHE_TTL_SECONDS=600
VOICE_EMOTION_SHADOW_WAIT_SECONDS=60
